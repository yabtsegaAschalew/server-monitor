# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# Values are interpolated into config.yaml via ${VAR} or ${VAR:default}.
# Interpolation happens after the YAML is parsed, so a value here can never
# change the structure of the config — only the value of an existing leaf.
# Never commit your real .env — it is git-ignored and docker-ignored.

# --- Google Gemini (Phase 3 diagnostic agent) -------------------------------
# Required for the diagnostic daemon / analyze commands. If left unset, the
# diagnostic module logs a warning and disables cleanly while collectors
# continue to run.
GEMINI_API_KEY=

# --- SNMPv3 (network collector) ----------------------------------------------
# Only needed if you uncomment snmp_targets in config.yaml. A target that
# declares auth_protocol/priv_protocol with an empty password fails config
# validation on purpose — SNMPv3 must never silently downgrade to cleartext.
# Leaving these blank is fine while snmp_targets is empty (the default).
SNMP_AUTH_PASSWORD=
SNMP_PRIV_PASSWORD=

# --- Alerting (Phase 4) ------------------------------------------------------
# Notification channels for the multi-burn-rate alert engine. The engine only
# runs under `--alert-engine` or `--all`.
#
# WARNING: alerting.enabled defaults to true. Setting a webhook URL here and
# starting the alert engine WILL post to that channel. Point it at a throwaway
# webhook first and confirm the formatting before using a real one.
#
# With none of these set, alerts are still evaluated and written to the
# active_alerts table, but nothing is sent.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# SMTP fallback. All four are needed for email to be considered configured
# (plus alerting.smtp.to_addrs in config.yaml, which is not a secret).
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Storage -----------------------------------------------------------------
# Where the SQLite database lives. The container image sets this to /data so it
# can run with a read-only root filesystem; locally the default is fine.
# MONITOR_DB_PATH=monitoring.db

# --- Docker transport --------------------------------------------------------
# DOCKER_BASE_URL points at docker-socket-proxy (read-only Docker API).
# DOCKER_SOCKET_PATH forces direct UDS mode instead, bypassing the proxy's
# restrictions — development only.
# DOCKER_BASE_URL=http://docker-socket-proxy:2375
# DOCKER_SOCKET_PATH=/var/run/docker.sock
